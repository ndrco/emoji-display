EMOJI_DISPLAY_DRIVER=serial
EMOJI_DISPLAY_HOST=127.0.0.1
EMOJI_DISPLAY_HTTP_PORT=18791
# Leave unset to auto-detect the Arduino port from available serial devices.
# EMOJI_DISPLAY_PORT=/dev/ttyACM0
EMOJI_DISPLAY_BAUD=115200
EMOJI_DISPLAY_LOG_LEVEL=INFO
EMOJI_DISPLAY_RESET_WAIT=2.0
EMOJI_DISPLAY_ACK_TIMEOUT=1.0
EMOJI_DISPLAY_INTERRUPT_MS=1600
# EMOJI_DISPLAY_TOKEN=change-me
